{
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(rm:*)"
    ],
    "allow": [
      "Bash(*)",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(gofmt *)",
      "Bash(bash scripts/*)"
    ]
  }
}
